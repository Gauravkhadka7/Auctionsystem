# Copy this file to .env and fill in real values before deploying.
# (python-dotenv isn't wired up by default — see README "Using a .env file"
# if you want these loaded automatically instead of via real env vars.)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to "postgresql" to switch off SQLite (see requirements.txt for the driver)
DB_ENGINE=sqlite
DB_NAME=auction_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis channel layer for WebSocket fan-out across multiple processes/workers.
# Leave blank to use the in-memory layer (fine for a single process).
# REDIS_URL=redis://127.0.0.1:6379/0

# Email — defaults to printing emails to the console in development.
# For real Gmail delivery set EMAIL_USE_SMTP=True (or set EMAIL_BACKEND
# explicitly to django.core.mail.backends.smtp.EmailBackend) and fill in the
# credentials below. Never commit real credentials.
#
# Gmail note: use a Google "App Password" (2-Step Verification must be on) as
# EMAIL_HOST_PASSWORD — your normal account password will be rejected.
EMAIL_USE_SMTP=False
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@auctionsystem.local

# Absolute site origin used in verification emails (no trailing slash).
# Leave blank to derive it from the incoming request instead.
SITE_BASE_URL=http://127.0.0.1:8000

# Email verification behaviour (seconds)
EMAIL_VERIFICATION_TIMEOUT=86400
EMAIL_OTP_TIMEOUT=1800
EMAIL_VERIFICATION_RESEND_COOLDOWN=60
EMAIL_VERIFICATION_RESEND_MAX_PER_HOUR=10
