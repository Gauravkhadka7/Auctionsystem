# Copy this file to .env and fill in real values before deploying.
# (python-dotenv isn't wired up by default — see README "Using a .env file"
# if you want these loaded automatically instead of via real env vars.)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to "postgresql" to switch off SQLite (see requirements.txt for the driver)
DB_ENGINE=sqlite
DB_NAME=auction_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email — defaults to printing emails to the console in development.
# Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend to send real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@auctionsystem.local
